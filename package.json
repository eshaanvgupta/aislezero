{
  "name": "aislezero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Merchant-controlled Nostr commerce with direct, non-custodial payments",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contracts": "node scripts/test-contract.mjs",
    "edge:dev": "wrangler dev --config apps/edge/wrangler.jsonc",
    "edge:deploy": "wrangler deploy --config apps/edge/wrangler.jsonc",
    "check": "npm run typecheck && npm test && npm run test:contracts && npm run build",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site:prepare": "npm run build && node scripts/prepare-worker.mjs",
    "site:deploy": "npm run site:prepare && wrangler deploy --config wrangler.site.jsonc"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "2.0.1",
    "@scure/btc-signer": "2.0.1",
    "@solana/kit": "^8.6.0",
    "@wallet-standard/app": "1.1.1",
    "decimal.js": "10.6.0",
    "idb-keyval": "6.2.2",
    "lucide-react": "0.577.0",
    "minisearch": "7.2.0",
    "nostr-tools": "2.26.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.6",
    "viem": "2.58.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@ethereumjs/vm": "^10.1.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.1",
    "prettier": "3.10.1",
    "solc": "^0.8.36",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0",
    "ws": "^8.23.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
